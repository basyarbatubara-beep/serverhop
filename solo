-- Render Server Cards to ScrollContainer (Strictly 1 Player)
renderSoloList = function()
    for _, child in ipairs(ScrollContainer:GetChildren()) do
        if child:IsA("Frame") and child.Name:sub(1, 9) == "SoloCard_" then
            child:Destroy()
        end
    end

    local filtered = {}

    for _, srv in ipairs(loadedSoloServers) do
        if (srv.playing == 1) and (srv.id ~= CurrentJobId) and not blacklistServers[srv.id] then
            table.insert(filtered, srv)
        end
    end

    -- Strict sort: lowest latency (ping) first
    table.sort(filtered, function(a, b)
        local aPing = a.ping or 9999
        local bPing = b.ping or 9999
        return aPing < bPing
    end)

    if #filtered == 0 then
        EmptyLabel.Visible = true
        EmptyLabel.Text = (isFetching and "Scanning for 1-player instances..." or "No 1-player servers found yet. Click Refresh to scan.")
    else
        EmptyLabel.Visible = false
        for index, srv in ipairs(filtered) do
            createServerCard(srv, index)
        end
    end

    if not isJoining then
        setStatus(string.format("%d 1-player servers found (sorted by ping)", #filtered), Color3.fromRGB(140, 146, 165))
    end
end

-- ========================================================================
-- ROBLOX API FETCHING (EXCLUSIVELY 1-PLAYER FILTER)
-- ========================================================================

local function fetchRobloxServers(cursor, onComplete)
    if isFetching then return end
    isFetching = true
    setStatus("Scanning Roblox for 1-player servers...", Color3.fromRGB(192, 132, 252))
    EmptyLabel.Text = "Scanning for 1-player servers..."
    EmptyLabel.Visible = true

    task.spawn(function()
        local cursorParam = (cursor and cursor ~= "") and ("&cursor=" .. safeUrlEncode(cursor)) or ""
        local url = string.format(
            "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100%s",
            tostring(PlaceId),
            cursorParam
        )

        local body = nil
        for attempt = 1, 2 do
            body = httpRequest(url)
            if body and body ~= "" and not string.find(body, "Too Many Requests") then
                break
            end
            task.wait(1.5)
        end

        isFetching = false

        if not body then
            setStatus("Network error querying servers.", Color3.fromRGB(239, 68, 68))
            EmptyLabel.Text = "Failed to query servers. Check executor HTTP support."
            if onComplete then onComplete(false) end
            return
        end

        local decodeSuccess, parsed = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodeSuccess or not parsed or not parsed.data then
            setStatus("Malformed response from Roblox API.", Color3.fromRGB(239, 68, 68))
            EmptyLabel.Text = "Could not parse server list JSON."
            if onComplete then onComplete(false) end
            return
        end

        nextPageCursor = parsed.nextPageCursor or ""

        if not cursor or cursor == "" then
            loadedSoloServers = {}
        end

        for _, srv in ipairs(parsed.data) do
            -- Only record instances that have EXACTLY 1 PLAYER
            if srv.playing == 1 then
                local exists = false
                for _, existing in ipairs(loadedSoloServers) do
                    if existing.id == srv.id then
                        exists = true
                        break
                    end
                end
                if not exists then
                    table.insert(loadedSoloServers, srv)
                end
            end
        end

        renderSoloList()
        if onComplete then onComplete(true) end
    end)
end

-- ========================================================================
-- 1-PLAYER AUTO-JOIN WATCHDOG & FALLBACK ENGINE
-- ========================================================================

stopJoining = function(reason)
    isJoining = false
    currentJoinIndex = 1
    soloCandidates = {}
    AutoJoinSoloBtn.Text = "Join 1-Player Server (Auto)"
    AutoJoinSoloBtn.BackgroundColor3 = Color3.fromRGB(124, 58, 237)

    if reason then
        notify("Solo Hop", reason, 4)
        setStatus(reason, Color3.fromRGB(239, 68, 68))
    end
end

executeJoinAttempt = function()
    if not isJoining then return end

    -- Advance past any blacklisted or current server
    while currentJoinIndex <= #soloCandidates do
        local candidate = soloCandidates[currentJoinIndex]
        if candidate and not blacklistServers[candidate.id] and candidate.id ~= CurrentJobId then
            break
        end
        currentJoinIndex = currentJoinIndex + 1
    end

    if currentJoinIndex > #soloCandidates then
        stopJoining("All 1-player candidate servers attempted. Refresh to rescan.")
        return
    end

    local target = soloCandidates[currentJoinIndex]
    local pingText = target.ping and string.format("%d ms", math.floor(target.ping)) or "N/A"

    local msg = string.format("Joining 1-Player Server #%d (Ping: %s)...", currentJoinIndex, pingText)
    setStatus(msg, Color3.fromRGB(245, 158, 11))
    notify("Solo Hop", msg, 3)

    setupQueueOnTeleport()

    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, target.id, LocalPlayer)
    end)

    if not success then
        blacklistServers[target.id] = true
        currentJoinIndex = currentJoinIndex + 1
        setStatus(string.format("Server #%d failed. Trying next 1-player server...", currentJoinIndex - 1), Color3.fromRGB(239, 68, 68))
        task.wait(1)
        executeJoinAttempt()
    else
        -- 8-second watchdog
        task.delay(8, function()
            if isJoining and currentJoinIndex <= #soloCandidates and soloCandidates[currentJoinIndex].id == target.id then
                setStatus("Connection timeout. Retrying next 1-player server...", Color3.fromRGB(245, 158, 11))
                blacklistServers[target.id] = true
                currentJoinIndex = currentJoinIndex + 1
                executeJoinAttempt()
            end
        end)
    end
end

-- Teleport Failure Listener (Advances down 1-player queue on ghost/closed server)
TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if player == LocalPlayer then
        local errStr = tostring(errorMessage or "Server closed or full")
        if isJoining and currentJoinIndex <= #soloCandidates then
            local failedServer = soloCandidates[currentJoinIndex]
            if failedServer then
                blacklistServers[failedServer.id] = true
            end
            currentJoinIndex = currentJoinIndex + 1
            setStatus(string.format("Server #%d closed. Trying next 1-player server...", currentJoinIndex - 1), Color3.fromRGB(239, 68, 68))
            notify("Solo Hop", "Server was closed. Retrying next 1-player server...", 3)
            task.wait(0.5)
            executeJoinAttempt()
        else
            setStatus("Teleport failed: " .. errStr, Color3.fromRGB(239, 68, 68))
            notify("Teleport Failed", errStr, 4)
        end
    end
end)

startSoloJoin = function()
    if isJoining then
        stopJoining("Auto-join canceled by user.")
        return
    end

    isJoining = true
    currentJoinIndex = 1
    AutoJoinSoloBtn.Text = "Cancel Auto Join"
    AutoJoinSoloBtn.BackgroundColor3 = Color3.fromRGB(225, 29, 72)
    setStatus("Building sorted 1-player queue...", Color3.fromRGB(192, 132, 252))

    soloCandidates = {}
    for _, srv in ipairs(loadedSoloServers) do
        if (srv.playing == 1) and (srv.id ~= CurrentJobId) and not blacklistServers[srv.id] then
            table.insert(soloCandidates, srv)
        end
    end

    -- Sort lowest latency first
    table.sort(soloCandidates, function(a, b)
        local aPing = a.ping or 9999
        local bPing = b.ping or 9999
        return aPing < bPing
    end)

    if #soloCandidates > 0 then
        executeJoinAttempt()
        return
    end

    -- If none loaded yet, fetch directly from Roblox API
    fetchRobloxServers("", function(ok)
        if not ok or not isJoining then
            if isJoining then stopJoining("Failed to query Roblox servers.") end
            return
        end

        soloCandidates = {}
        for _, srv in ipairs(loadedSoloServers) do
            if (srv.playing == 1) and (srv.id ~= CurrentJobId) and not blacklistServers[srv.id] then
                table.insert(soloCandidates, srv)
            end
        end

        table.sort(soloCandidates, function(a, b)
            local aPing = a.ping or 9999
            local bPing = b.ping or 9999
            return aPing < bPing
        end)

        if #soloCandidates > 0 then
            executeJoinAttempt()
        else
            stopJoining("No 1-player servers found right now. Try again shortly.")
        end
    end)
end

